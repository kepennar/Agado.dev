---
// 404 Not Found page

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/components/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Spacer from "@/components/Spacer.astro";
import type { Language } from "@/i18n/i18n.model";
import { getTranslations, localizedUrl } from "@/i18n/i18n.model";

const url = new URL(Astro.request.url);
const lang: Language = url.pathname.startsWith("/en") ? "en" : "fr";
const t = getTranslations(lang);
---

<Layout title={t.notFound.title} description={t.notFound.message} lang={lang}>
  <div class="min-h-screen pt-16">
    <div class="fixed w-full top-0 z-50">
      <Navbar
        currentLanguage={lang}
        translations={{
          articles: t.nav.articles,
          brand: t.nav.brand,
          about: t.nav.about,
          expertises: t.nav.expertises,
          experience: t.nav.experience,
          posts: t.nav.posts,
          toggleDarkMode: t.aria.toggleDarkMode,
          switchToLight: t.aria.switchToLight,
          switchToDark: t.aria.switchToDark,
        }}
      />
    </div>

    <main id="main-content">
      <Header siteTitle={t.notFound.title} subtitle="" />

      <div class="max-w-4xl mx-auto px-4 py-8">
        <Spacer direction="vertical" size="4rem" />

        <div class="error-container">
          <div class="error-code">404</div>

          <Spacer direction="vertical" size="2rem" />

          <h1 class="error-title">{t.notFound.title}</h1>
          <p class="error-message">{t.notFound.message}</p>

          <Spacer direction="vertical" size="3rem" />

          <div class="action-buttons">
            <a href={localizedUrl("/", lang)} class="btn-outline">
              {t.notFound.backHome}
            </a>

            <a href={localizedUrl("/blog", lang)} class="btn-outline">
              {t.nav.articles}
            </a>
          </div>
        </div>

        <Spacer direction="vertical" size="4rem" />
      </div>
    </main>

    <Footer
      madeWith={t.footer.madeWith}
      by={t.footer.by}
      copyright={t.footer.copyright}
    />
  </div>
</Layout>

<style>
  .error-container {
    text-align: center;
    padding: 2rem;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 4rem + 8vw, 10rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--bp-accent);
    margin: 0;
  }

  .error-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    color: var(--bp-ink);
    margin: 0 0 1rem 0;
  }

  .error-message {
    font-size: 1.125rem;
    color: var(--bp-muted);
    margin: 0;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
