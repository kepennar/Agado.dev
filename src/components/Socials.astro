---
// Socials component - displays social media links
// Migrated from Gatsby/src/components/Socials.component.tsx
// Updated to use Astro Image component for optimization

import { Image } from "astro:assets";

import { getImageMetadata } from "@/lib/contentful";
import type { Social } from "@/lib/contentful.types";

interface Props {
  socials: Social[];
}

const { socials } = Astro.props;
---

<div class="flex">
  <!-- Light backdrop in dark mode too: the logos are dark on transparent -->
  <div class="flex flex-wrap justify-start p-2 rounded-md bg-white/30 dark:bg-white/90 gap-8 sm:gap-12">
    {socials.map((social) => {
      const imageData = getImageMetadata(social.fields.picto);
      // Displayed at most 28px tall (sm:h-7): serve 2x for high-DPI screens
      const height = 56;
      const width = Math.round((imageData.width * height) / imageData.height);
      // Astro 7 refuses to rasterize SVG: keep vector logos as they are
      return (
        <a
          href={social.fields.url}
          target="_blank"
          rel="noopener noreferrer"
          class="h-6 print:h-4 sm:h-7 hover:opacity-80 hover:scale-110 transition-all duration-200"
          title={social.fields.label}
        >
          <Image
            src={imageData.src}
            alt={imageData.alt || `${social.fields.label} logo`}
            width={width}
            height={height}
            class="h-full w-auto"
            loading="eager"
            format={/\.svg$/i.test(imageData.src) ? "svg" : "webp"}
          />
        </a>
      );
    })}
  </div>
</div>
