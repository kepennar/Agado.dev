---
// BlogLink component - displays a single blog post entry in the blog listing
// Shows title, date, abstract with embedded images, and "Read more" link
// Used in blog listing page (T041)

import type { BlogPost } from "@/lib/contentful.types";

import RichText from "./ContentfulRichText/RichText.astro";

interface Props {
  blogPost: BlogPost;
  locale: "fr" | "en";
  readingTime?: number;
}

const { blogPost, locale, readingTime } = Astro.props;

// Reading time label
const readingTimeLabel = locale === "en" ? "min read" : "min de lecture";

// Determine the blog post URL based on locale
const blogUrl =
  locale === "en"
    ? `/en/blog/${blogPost.fields.slug}`
    : `/blog/${blogPost.fields.slug}`;

// Format the publish date
const publishDate = blogPost.fields.publishDate
  ? new Date(blogPost.fields.publishDate).toLocaleDateString(
      locale === "en" ? "en-US" : "fr-FR",
      {
        year: "numeric",
        month: "long",
        day: "numeric",
      },
    )
  : "";

// Get "Read more" text based on locale
const readMoreText = locale === "en" ? "Read more" : "Lire la suite";
---

<a href={blogUrl} class="blog-link">
  <article class="blog-link-container bp-panel bp-panel-hover">
    <h2 class="blog-title">{blogPost.fields.title}</h2>

    {publishDate && (
      <div class="blog-meta bp-meta">
        <time class="blog-date" datetime={blogPost.fields.publishDate}>
          {publishDate}
        </time>
        {readingTime && (
          <span class="blog-reading-time">
            <span aria-hidden="true">/</span> {readingTime} {readingTimeLabel}
          </span>
        )}
      </div>
    )}

    {blogPost.fields.abstract && (
      <div class="blog-abstract cms-content">
        <RichText content={blogPost.fields.abstract} />
      </div>
    )}

    <div class="blog-read-more">
      <span>{readMoreText}</span>
      <svg
        class="arrow-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </div>
  </article>
</a>

<style>
  .blog-link {
    display: block;
    margin-bottom: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .blog-link-container {
    padding: 1.75rem;
  }

  .blog-title {
    margin: 0 0 0.75rem 0;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.65rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--bp-ink);
    transition: color 0.2s ease;
  }

  .blog-link:hover .blog-title {
    color: var(--bp-accent);
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .blog-abstract {
    margin-bottom: 1.25rem;
    color: var(--bp-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-abstract :global(.cms-content) {
    font-size: 1.0625rem;
    color: inherit;
  }

  /* Style images in abstract */
  .blog-abstract :global(img) {
    width: 100%;
    max-height: 18rem;
    object-fit: cover;
    margin: 1rem 0;
  }

  .blog-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bp-accent);
  }

  .blog-read-more :global(.arrow-icon) {
    transition: transform 0.2s ease;
  }

  .blog-link:hover .blog-read-more :global(.arrow-icon) {
    transform: translateX(3px);
  }
</style>
