---
// LanguageSwitch - pure Astro component (no React needed)
// Toggle between French (/) and English (/en) versions

interface Props {
  currentLanguage: "fr" | "en";
  currentPath: string;
}

const { currentLanguage, currentPath } = Astro.props;
const targetLang = currentLanguage === "fr" ? "en" : "fr";

// Calculate target URL
const targetUrl =
  currentLanguage === "fr"
    ? `/en${currentPath === "/" ? "" : currentPath}`
    : currentPath.replace(/^\/en/, "") || "/";
---

<a
  href={targetUrl}
  id="language-switch"
  class="group flex items-center gap-1.5 h-9 px-2.5 rounded-sm border border-bp-line text-bp-ink hover:border-bp-accent hover:text-bp-accent transition-colors cursor-pointer no-underline"
  aria-label={
    currentLanguage === "fr" ? "Switch to English" : "Passer en français"
  }
  title={currentLanguage === "fr" ? "Switch to English" : "Passer en français"}
  data-target-lang={targetLang}
>
  <svg
    class="w-4 h-4"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
    <path d="M2 12h20"></path>
  </svg>
  <span class="font-mono text-xs font-medium tracking-wider uppercase">
    {targetLang}
  </span>
</a>

<script is:inline>
  (function () {
    var link = document.getElementById("language-switch");
    if (!link) return;
    link.addEventListener("click", function () {
      var lang = link.getAttribute("data-target-lang");
      document.cookie =
        "locale=" + lang + "; path=/; max-age=2592000; SameSite=Lax";
    });
  })();
</script>
