---
// CaseStudies component - problem → approach → measured results, one card per case study
// Renders nothing when there are no case studies

import RichText from "@/components/ContentfulRichText/RichText.astro";
import { parseMetrics } from "@/lib/case-study";
import { getContentfulImageUrl } from "@/lib/contentful";
import type { CaseStudy } from "@/lib/contentful.types";

interface Props {
  caseStudies: CaseStudy[];
  translations: {
    caseStudiesLabel: string;
    caseStudiesTitle: string;
    caseStudyProblem: string;
    caseStudyApproach: string;
    caseStudyResults: string;
    caseStudyStack: string;
  };
}

const { caseStudies, translations } = Astro.props;
---

{caseStudies.length > 0 && (
  <section id="case-studies" class="py-16 sm:py-24 print:py-6">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <span class="section-label">{translations.caseStudiesLabel}</span>
      <h2 class="section-title">{translations.caseStudiesTitle}</h2>

      <div class="flex flex-col gap-8">
        {caseStudies.map((caseStudy, i) => {
          const { fields } = caseStudy;
          const metrics = parseMetrics(fields.results);
          const meta = [fields.context, fields.period, fields.role].filter(
            Boolean,
          );
          // An unpublished asset arrives as an unresolved link without fields
          const cover =
            fields.cover && "fields" in fields.cover ? fields.cover : undefined;
          return (
            <article
              id={`case-study-${fields.slug}`}
              class="case-study bp-panel break-inside-avoid"
            >
              {cover?.fields.file && (
                <img
                  src={getContentfulImageUrl(cover, { width: 1200 })}
                  alt=""
                  class="w-full aspect-[16/5] object-cover border-b border-bp-line print:hidden"
                  loading="lazy"
                />
              )}
              <div class="p-6 sm:p-8 print:p-3">
                <div class="flex items-start justify-between gap-4 mb-3">
                  {meta.length > 0 && (
                    <p class="bp-meta m-0">{meta.join(" · ")}</p>
                  )}
                  <span
                    aria-hidden="true"
                    class="ml-auto font-mono text-xs tracking-widest text-bp-faint"
                  >
                    {`/${String(i + 1).padStart(2, "0")}`}
                  </span>
                </div>
                <h3 class="font-sans text-2xl font-bold tracking-tight leading-snug text-bp-ink mb-6">
                  {fields.title}
                </h3>

                {metrics.length > 0 && (
                  <div class="mb-8">
                    <h4 class="sr-only">{translations.caseStudyResults}</h4>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 m-0">
                      {metrics.map((metric) => (
                        <div class="metric flex flex-col-reverse justify-end pl-4 py-1 border-l border-bp-line-strong">
                          <dt class="text-sm leading-snug text-bp-muted">
                            {metric.label}
                          </dt>
                          {metric.value && (
                            <dd class="font-mono text-2xl font-medium text-bp-accent m-0 mb-1">
                              {metric.value}
                            </dd>
                          )}
                        </div>
                      ))}
                    </dl>
                  </div>
                )}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div>
                    <h4 class="font-mono text-xs uppercase tracking-[0.16em] text-bp-accent mb-3">
                      {translations.caseStudyProblem}
                    </h4>
                    <p class="text-[0.95rem] leading-relaxed text-bp-muted m-0">
                      {fields.problem}
                    </p>
                  </div>
                  {(fields.approach || fields.architecture?.length) && (
                    <div>
                      <h4 class="font-mono text-xs uppercase tracking-[0.16em] text-bp-accent mb-3">
                        {translations.caseStudyApproach}
                      </h4>
                      {fields.approach && (
                        <div class="case-approach text-bp-muted">
                          <RichText content={fields.approach} />
                        </div>
                      )}
                      {fields.architecture &&
                        fields.architecture.length > 0 && (
                          <ul class="list-disc pl-5 m-0 text-[0.95rem] leading-relaxed text-bp-muted marker:text-bp-accent">
                            {fields.architecture.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        )}
                    </div>
                  )}
                </div>

                {fields.stack && fields.stack.length > 0 && (
                  <div class="flex flex-wrap items-center gap-2 mt-6 pt-5 border-t border-bp-line text-bp-muted">
                    <span class="sr-only">{translations.caseStudyStack}:</span>
                    {fields.stack.map((tech) => (
                      <span class="bp-chip">{tech}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  /* Rich text defaults are sized for blog articles: match the card's body text */
  .case-approach :global(.cms-content) {
    font-size: 0.95rem;
    line-height: 1.625;
    color: inherit;
  }

  .case-approach :global(.cms-content p) {
    margin-bottom: 0.75rem;
  }

  .case-approach :global(.cms-content ul),
  .case-approach :global(.cms-content ol) {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
  }

  .case-approach :global(.cms-content li) {
    margin-bottom: 0;
  }

  .case-approach :global(.cms-content li p) {
    margin-bottom: 0;
  }

  .case-approach :global(.cms-content li::marker) {
    color: var(--bp-accent);
  }
</style>
