---
// Table of Contents component - displays navigation links for blog post headings
// Extracts H2 headings from rich text content and creates anchor links
// Task T046

import type { Document } from "@contentful/rich-text-types";

import { extractTableOfContents } from "@/lib/toc-extractor";

interface Props {
  content: Document;
  locale?: "fr" | "en";
}

const { content, locale = "fr" } = Astro.props;

// Extract H2 headings for table of contents
const tocItems = extractTableOfContents(content);

// Only show TOC if there are at least 2 headings
const showToc = tocItems.length >= 2;

// Get translated title
const tocTitle = locale === "en" ? "Table of Contents" : "Table des matières";
---

{showToc && (
  <nav class="toc bp-panel" id="toc">
    <h2 class="toc-title">{tocTitle}</h2>
    <ul class="toc-list">
      {tocItems.map((item) => (
        <li class:list={[`toc-item toc-level-${item.level}`]}>
          <a href={`#${item.id}`} class="toc-link">
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    margin: 2rem 0;
    padding: 1.5rem 1.75rem;
  }

  .toc-title {
    margin: 0 0 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bp-accent);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .toc-item {
    display: flex;
    gap: 0.875rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--bp-line);
  }

  .toc-item:first-child {
    border-top: 0;
  }

  .toc-level-2::before {
    counter-increment: toc;
    content: counter(toc, decimal-leading-zero) / "";
    flex: none;
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--bp-faint);
  }

  .toc-link {
    color: var(--bp-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-link:hover {
    color: var(--bp-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Indent nested headings */
  .toc-level-3 {
    padding-left: 2rem;
    font-size: 0.95rem;
  }

  .toc-level-4,
  .toc-level-5,
  .toc-level-6 {
    padding-left: 3rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .toc {
      padding: 1.25rem;
      margin: 1.5rem 0;
    }
  }
</style>
