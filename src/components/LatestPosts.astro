---
// LatestPosts component - Horizontal 3-card grid with cover images
// Extracts first embedded image from blog abstract rich text if available

import type { BlogPost } from "@/lib/contentful.types";

interface Props {
  posts: BlogPost[];
  locale: "fr" | "en";
  title: string;
  seeAllText: string;
  seeAllUrl: string;
  sectionLabel: string;
}

const { posts, locale, title, seeAllText, seeAllUrl, sectionLabel } =
  Astro.props;

// Take only first 3
const latestPosts = posts.slice(0, 3);

// Extract the first embedded image URL from a Contentful rich text Document
function getAbstractImageUrl(post: BlogPost): string | null {
  const doc = post.fields.abstract as any;
  if (!doc || !doc.content) return null;

  for (const node of doc.content) {
    if (node.nodeType === "embedded-asset-block") {
      const asset = (node as any).data?.target;
      if (asset?.fields?.file?.url) {
        const url = asset.fields.file.url as string;
        return url.startsWith("//")
          ? `https:${url}?w=600&fm=webp&q=80`
          : `${url}?w=600&fm=webp&q=80`;
      }
    }
  }
  return null;
}
---

{latestPosts.length > 0 && (
  <section
    id="posts"
    class="py-16 sm:py-24 bg-bp-surface-alt border-t border-bp-line print:hidden"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <span class="section-label">{sectionLabel}</span>
      <h2 class="section-title">{title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-5">
        {latestPosts.map((post, index) => {
          const blogUrl =
            locale === "en"
              ? `/en/blog/${post.fields.slug}`
              : `/blog/${post.fields.slug}`;
          const publishDate = post.fields.publishDate
            ? new Date(post.fields.publishDate).toLocaleDateString(
                locale === "en" ? "en-US" : "fr-FR",
                { year: "numeric", month: "short", day: "numeric" },
              )
            : "";
          const imageUrl = getAbstractImageUrl(post);
          return (
            <a
              href={blogUrl}
              class="post-card group bp-panel bp-panel-hover flex flex-col no-underline text-inherit"
            >
              <div class="post-cover relative aspect-[16/10] overflow-hidden border-b border-bp-line">
                {imageUrl ? (
                  <img
                    style={`view-transition-name: post-cover-${post.fields.slug}; view-transition-class: vt-cover`}
                    src={imageUrl}
                    alt=""
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="bp-grid w-full h-full flex items-end p-5"
                    style={`view-transition-name: post-cover-${post.fields.slug}; view-transition-class: vt-cover`}
                    aria-hidden="true"
                  >
                    <span class="font-mono text-5xl font-medium text-bp-line-strong">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                {publishDate && (
                  <time
                    class="bp-meta uppercase"
                    datetime={post.fields.publishDate}
                  >
                    {publishDate}
                  </time>
                )}
                <h3
                  style={`view-transition-name: post-title-${post.fields.slug}; view-transition-class: vt-title`}
                  class="font-sans text-[1.05rem] font-bold tracking-tight text-bp-ink leading-snug group-hover:text-bp-accent transition-colors"
                >
                  {post.fields.title}
                </h3>
                <span
                  aria-hidden="true"
                  class="mt-auto pt-2 font-mono text-sm text-bp-accent transition-transform duration-200 group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </div>
            </a>
          );
        })}
      </div>
      <div class="mt-10 text-center">
        <a href={seeAllUrl} class="btn-outline">
          {seeAllText}
        </a>
      </div>
    </div>
  </section>
)}
