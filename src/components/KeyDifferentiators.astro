---
// KeyDifferentiators component - Stacked quote + detailed bio section
// Uses CMS slogan as prominent quote, CMS abstract as detailed content

import type { Abstract, Slogan } from "@/lib/contentful.types";

import RichText from "./ContentfulRichText/RichText.astro";

interface Props {
  slogan?: Slogan;
  abstract?: Abstract;
  translations: {
    keyDifferentiators: string;
    differentiatorQuote2: string;
  };
}

const { slogan, abstract, translations } = Astro.props;
---

<section class="py-16 sm:py-24 border-b border-bp-line bg-bp-surface-alt print:bg-transparent print:py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <span class="section-label">{translations.keyDifferentiators}</span>

    {slogan?.fields?.text && (
      <div class="slogan mt-8 max-w-4xl text-bp-ink">
        <RichText content={slogan.fields.text} />
      </div>
    )}

    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-12 items-start">
      {abstract?.fields?.content && (
        <div class="abstract lg:col-span-7 text-bp-muted">
          <RichText content={abstract.fields.content} />
        </div>
      )}

      <figure class="bp-panel m-0 p-6 sm:p-8 lg:col-span-5 print:border-0 print:p-0">
        <span
          aria-hidden="true"
          class="block font-mono text-3xl leading-none text-bp-accent mb-4 print:hidden"
        >
          &gt;_
        </span>
        <blockquote class="m-0 font-serif text-lg italic leading-relaxed text-bp-ink">
          {translations.differentiatorQuote2}
        </blockquote>
      </figure>
    </div>
  </div>
</section>

<style>
  .slogan :global(.cms-content) {
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.35;
    font-style: italic;
    color: inherit;
  }

  .slogan :global(.cms-content p:last-child) {
    margin-bottom: 0;
  }

  .abstract :global(.cms-content) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: inherit;
  }
</style>
