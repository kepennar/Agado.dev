---
import RichText from "@/components/ContentfulRichText/RichText.astro";
import Toc from "@/components/ContentfulRichText/Toc.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/components/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ReadingProgressBar from "@/components/ReadingProgressBar.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import Spacer from "@/components/Spacer.astro";
import type { Language } from "@/i18n/i18n.model";
import {
  getContentfulLocaleParam,
  getDateLocale,
  getTranslations,
  localizedUrl,
} from "@/i18n/i18n.model";
import { getBlogPost } from "@/lib/contentful";
import { estimateReadingTime } from "@/lib/reading-time";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = (Astro.currentLocale || "fr") as Language;
const t = getTranslations(lang);
const locale = getContentfulLocaleParam(lang);

const post = await getBlogPost(slug, locale);

if (!post) {
  return Astro.redirect(localizedUrl("/404", lang));
}

const publishDate = post.fields.publishDate
  ? new Date(post.fields.publishDate).toLocaleDateString(getDateLocale(lang), {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const pageTitle = `${post.fields.title} - Agado Dev`;
const pageDescription =
  post.fields.abstract && "content" in post.fields.abstract
    ? (post.fields.abstract as any).content
        .filter((node: any) => node.nodeType === "paragraph")
        .map((node: any) => node.content.map((c: any) => c.value).join(""))
        .join(" ")
        .slice(0, 160)
    : t.seo.defaultDescription;

const readingTime = post.fields.content
  ? estimateReadingTime(post.fields.content)
  : undefined;

// The article opens with its cover image: lift it above the table of contents so
// it is in view and can receive the card -> article morph (view transition)
const content = post.fields.content as any;
const leadsWithImage =
  content?.content?.[0]?.nodeType === "embedded-asset-block";
const coverDoc = leadsWithImage
  ? { ...content, content: content.content.slice(0, 1) }
  : null;
const bodyDoc = leadsWithImage
  ? { ...content, content: content.content.slice(1) }
  : content;

const featuredImage = "/images/og-default.png";
const shareUrl = `https://agado.dev${localizedUrl(`/blog/${post.fields.slug}`, lang)}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  type="article"
  image={featuredImage}
>
  <div class="min-h-screen pt-16">
    <ReadingProgressBar />
    <div class="fixed w-full top-0 z-50">
      <Navbar
        currentLanguage={lang}
        translations={{
          articles: t.nav.articles,
          brand: t.nav.brand,
          about: t.nav.about,
          expertises: t.nav.expertises,
          experience: t.nav.experience,
          posts: t.nav.posts,
          toggleDarkMode: t.aria.toggleDarkMode,
          switchToLight: t.aria.switchToLight,
          switchToDark: t.aria.switchToDark,
        }}
      />
    </div>

    <main id="main-content">
      <Header
        siteTitle={post.fields.title}
        subtitle={publishDate}
        titleTransition={`post-title-${slug}`}
      />

      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
        <div class="article-meta bp-meta">
          {publishDate && (
            <time datetime={post.fields.publishDate} class="publish-date">
              {t.common.published} {publishDate}
            </time>
          )}
          {readingTime && (
            <span class="reading-time">
              <span aria-hidden="true">/</span> {readingTime}{" "}
              {t.blog.readingTime}
            </span>
          )}
        </div>

        {coverDoc && (
          <div
            class="post-cover"
            style={`view-transition-name: post-cover-${slug}; view-transition-class: vt-cover`}
          >
            <RichText content={coverDoc} />
          </div>
        )}

        {post.fields.content && (
          <Toc content={post.fields.content} locale={lang} />
        )}

        <Spacer direction="vertical" size="2rem" />

        {post.fields.content && (
          <article class="blog-post-content">
            <RichText content={bodyDoc} />
          </article>
        )}

        <ShareButtons
          url={shareUrl}
          translations={{
            shareOn: t.blog.shareOn,
            copyLink: t.blog.copyLink,
            linkCopied: t.blog.linkCopied,
          }}
        />

        <Spacer direction="vertical" size="2rem" />

        <div class="text-center">
          <a href={localizedUrl("/blog", lang)} class="btn-outline">
            {t.common.backToBlog}
          </a>
        </div>
      </div>
    </main>

    <Footer
      madeWith={t.footer.madeWith}
      by={t.footer.by}
      copyright={t.footer.copyright}
    />
  </div>
</Layout>

<style>
  .post-cover {
    margin-top: 1.5rem;
    border: 1px solid var(--bp-line);
    background: var(--bp-surface);
    line-height: 0;
  }

  .post-cover :global(.rich-text-image) {
    margin: 0;
  }

  /* Same crop family as the cards (16:10) so the morph keeps its shape */
  .post-cover :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .blog-post-content {
    max-width: 100%;
    overflow-wrap: break-word;
  }

  @media print {
    .article-meta {
      margin-bottom: 2rem;
    }
  }
</style>
