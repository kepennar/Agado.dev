---
// Navbar component - site navigation bar with anchor links

import { getTranslations } from "@/i18n/i18n.model";

import DarkModeSwitch from "./DarkModeSwitch.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  currentLanguage: "fr" | "en";
  translations: {
    brand: string;
    about: string;
    expertises: string;
    experience: string;
    posts: string;
    articles: string;
    toggleDarkMode: string;
    switchToLight: string;
    switchToDark: string;
  };
}

const { currentLanguage = "fr", translations } = Astro.props;
const { openMenu, closeMenu } = getTranslations(currentLanguage).aria;

const homeUrl = currentLanguage === "fr" ? "/" : `/${currentLanguage}`;

// Get current path for language switching
const currentPath = Astro.url.pathname;

// If we have the full nav links, show anchor nav; otherwise show blog link
const hasFullNav = !!translations.brand;

const navLinks = hasFullNav
  ? [
      { label: translations.about, href: "#about" },
      { label: translations.expertises, href: "#services" },
      { label: translations.experience, href: "#experience" },
      { label: translations.posts, href: "#posts" },
    ]
  : [];

const blogUrl = currentLanguage === "fr" ? "/blog" : `/${currentLanguage}/blog`;
---

<nav class="navbar w-full flex items-center h-16 px-4 sm:px-6 backdrop-blur-md border-b border-bp-line bg-bp-bg/85 print:border-0">
  <div class="flex justify-between items-center w-full max-w-6xl mx-auto">
    <!-- Brand -->
    <a
      href={homeUrl}
      class="group flex items-center gap-2.5 font-sans text-[0.95rem] font-bold tracking-tight text-bp-ink no-underline whitespace-nowrap hover:text-bp-accent transition-colors"
    >
      <svg
        aria-hidden="true"
        class="w-6 h-6 text-bp-accent print:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
      >
        <rect x="1.5" y="1.5" width="21" height="21" rx="1" />
        <rect x="9" y="5" width="6" height="4" />
        <rect x="4.5" y="15" width="6" height="4" />
        <rect x="13.5" y="15" width="6" height="4" />
        <path d="M12 9v3M7.5 15v-3h9v3" />
      </svg>
      {translations.brand}
    </a>

    <!-- Nav Links (desktop) -->
    {hasFullNav ? (
      <div class="hidden md:flex items-center gap-7 print:hidden">
        {navLinks.map((link, i) => (
          <a
            href={link.href}
            class="nav-link group font-mono text-xs font-medium uppercase tracking-[0.12em] text-bp-muted no-underline hover:text-bp-accent transition-colors"
          >
            <span
              aria-hidden="true"
              class="text-bp-faint group-hover:text-bp-accent mr-1.5"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            {link.label}
          </a>
        ))}
      </div>
    ) : (
      <div class="flex items-center gap-6 print:hidden">
        <a
          href={blogUrl}
          class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-bp-muted no-underline hover:text-bp-accent transition-colors"
        >
          {translations.articles}
        </a>
      </div>
    )}

    <!-- Actions -->
    <div class="flex items-center gap-2 print:hidden">
      <DarkModeSwitch
        ariaLabel={translations.toggleDarkMode}
        lightLabel={translations.switchToLight}
        darkLabel={translations.switchToDark}
      />
      <LanguageSwitch
        currentLanguage={currentLanguage}
        currentPath={currentPath}
      />
      {hasFullNav && (
        <button
          class="mobile-menu-btn md:hidden flex items-center justify-center h-9 w-9 rounded-sm border border-bp-line text-bp-ink hover:border-bp-accent hover:text-bp-accent"
          aria-label={openMenu}
          data-open-label={openMenu}
          data-close-label={closeMenu}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            aria-hidden="true"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              class="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
            <path
              class="close-icon hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      )}
    </div>
  </div>
</nav>

<!-- Mobile menu (only for pages with full nav) -->
{hasFullNav && (
  <div
    id="mobile-menu"
    class="mobile-menu hidden md:hidden fixed top-16 left-0 right-0 z-40 bg-bp-bg border-b border-bp-line shadow-lg print:hidden"
  >
    <div class="flex flex-col py-2 px-4">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="mobile-nav-link py-3.5 font-mono text-sm font-medium uppercase tracking-[0.1em] text-bp-muted no-underline hover:text-bp-accent border-b border-bp-line last:border-0"
        >
          <span aria-hidden="true" class="text-bp-faint mr-3">
            {String(i + 1).padStart(2, "0")}
          </span>
          {link.label}
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .navbar {
    transition: box-shadow 0.3s ease;
  }

  .navbar.scrolled {
    box-shadow: 0 8px 24px -16px rgb(10 22 40 / 0.35);
  }

  @media print {
    .navbar.scrolled {
      box-shadow: none;
    }
  }
</style>

<!-- data-astro-rerun: re-run after each ClientRouter navigation -->
<script is:inline data-astro-rerun>
  (function () {
    var nav = document.querySelector(".navbar");
    if (!nav) return;

    // Re-run after each view-transition swap: drop the previous page's window/document listeners
    if (window.__navAbort) window.__navAbort.abort();
    var signal = (window.__navAbort = new AbortController()).signal;

    // Scroll shadow
    function onScroll() {
      if (window.scrollY > 10) {
        nav.classList.add("scrolled");
      } else {
        nav.classList.remove("scrolled");
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    onScroll();

    // Mobile menu toggle
    var menuBtn = document.querySelector(".mobile-menu-btn");
    var mobileMenu = document.querySelector(".mobile-menu");
    var menuIcon = document.querySelector(".menu-icon");
    var closeIcon = document.querySelector(".close-icon");

    if (menuBtn && mobileMenu) {
      function setOpen(open) {
        mobileMenu.classList.toggle("hidden", !open);
        menuIcon.classList.toggle("hidden", open);
        closeIcon.classList.toggle("hidden", !open);
        menuBtn.setAttribute("aria-expanded", String(open));
        menuBtn.setAttribute(
          "aria-label",
          menuBtn.getAttribute(open ? "data-close-label" : "data-open-label"),
        );
      }

      menuBtn.addEventListener("click", function () {
        setOpen(mobileMenu.classList.contains("hidden"));
      });

      // Close menu on link click
      mobileMenu.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
          setOpen(false);
        });
      });

      document.addEventListener(
        "keydown",
        function (e) {
          if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
            setOpen(false);
            menuBtn.focus();
          }
        },
        { signal },
      );
    }
  })();
</script>
