---
// Footer component - Simple copyright footer

interface Props {
  madeWith: string;
  by: string;
  copyright: string;
}

const { copyright } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer relative z-10 border-t border-bp-line bg-bp-bg print:border-0">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-wrap items-center justify-between gap-4 print:hidden">
    <p class="bp-meta m-0">{copyright.replace("{year}", String(year))}</p>
    <span aria-hidden="true" class="bp-meta flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 bg-bp-signal"></span>
      agado.dev
    </span>
  </div>
</footer>
