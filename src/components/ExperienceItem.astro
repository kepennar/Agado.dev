---
// ExperienceItem component - Two-column timeline entry
// Left: company + date, Center: rail + node, Right: role + description

import RichText from "@/components/ContentfulRichText/RichText.astro";
import type { Experience } from "@/lib/contentful.types";

interface Props {
  experience: Experience;
  index?: number;
  recent?: boolean;
}

const { experience, recent = true } = Astro.props;
---

<div class="timeline-item">
  <!-- Left column: company + date -->
  <div class="timeline-left text-right pt-0.5 max-sm:text-left max-sm:flex max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1 max-sm:items-baseline">
    <span class="block font-sans text-base font-bold tracking-tight text-bp-ink">
      {experience.fields.projectLink ? (
        <a
          href={experience.fields.projectLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-inherit no-underline transition-colors duration-200 hover:text-bp-accent"
        >
          {experience.fields.project}
        </a>
      ) : (
        experience.fields.project
      )}
    </span>
    <span class="block bp-meta mt-1.5 max-sm:mt-0">
      {experience.fields.duration}
    </span>
  </div>

  <!-- Center: node + rail -->
  <div class="timeline-rail flex flex-col items-center relative w-5">
    <div
      class:list={[
        "timeline-node shrink-0 mt-1.5 z-10 rotate-45",
        recent
          ? "w-3 h-3 bg-bp-accent outline outline-1 outline-offset-[3px] outline-bp-accent"
          : "w-2.5 h-2.5 bg-bp-bg border border-bp-accent",
      ]}
    ></div>
    <div class="timeline-line w-px flex-1 bg-bp-line-strong mt-2.5"></div>
  </div>

  <!-- Right column: role + description -->
  <div class="pb-2">
    <h3 class="font-sans text-lg font-bold text-bp-accent mb-2 leading-snug">
      {experience.fields.title}
    </h3>
    {experience.fields.details && (
      <div class="timeline-details text-bp-muted">
        <RichText content={experience.fields.details} />
      </div>
    )}
  </div>
</div>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr auto 2fr;
    gap: 1.75rem;
    padding-bottom: 2.25rem;
    position: relative;
  }

  .timeline-details :global(.cms-content) {
    font-size: 1rem;
    line-height: 1.65;
    color: inherit;
  }

  .timeline-details :global(.cms-content p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: auto 1fr;
      gap: 0.5rem 1rem;
    }

    .timeline-left {
      grid-column: 2;
      grid-row: 1;
    }

    .timeline-item > div:nth-child(2) {
      grid-column: 1;
      grid-row: 1 / -1;
    }

    .timeline-item > div:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* Hide line on last item */
  .timeline-item:last-child .timeline-line {
    display: none;
  }

  @media print {
    .timeline-item {
      break-inside: avoid;
    }

    .timeline-item > div:nth-child(2) {
      display: none;
    }

    .timeline-item {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
