---
// Header component - Hero section (homepage) or simple header (other pages)
// Hero shows only the first paragraph of the CMS abstract as a short intro.

import type { Translations } from "@/i18n/fr";
import type { Abstract, Social } from "@/lib/contentful.types";

import RichText from "./ContentfulRichText/RichText.astro";
import Socials from "./Socials.astro";
import SystemDiagram from "./SystemDiagram.astro";

interface Props {
  siteTitle?: string;
  subtitle?: string;
  /** view-transition-name for the page title (shared-element morph from a card) */
  titleTransition?: string;
  translations?: {
    heroLabel: string;
    heroSubtitle: string;
    seeExperienceBtn: string;
    diagram: Translations["home"]["diagram"];
  };
  abstract?: Abstract;
  socials?: Social[];
}

const {
  siteTitle = "",
  subtitle,
  titleTransition,
  translations,
  abstract,
  socials,
} = Astro.props;
const isHero = !!translations;

// Extract only the first paragraph from the abstract for the hero intro
let heroIntroContent: any = null;
const abstractDoc = abstract?.fields?.content as any;
if (abstractDoc) {
  const firstParagraph = abstractDoc.content?.find(
    (node: any) => node.nodeType === "paragraph",
  );
  if (firstParagraph) {
    heroIntroContent = {
      ...abstractDoc,
      content: [firstParagraph],
    };
  }
}
---

{isHero ? (
  <header
    id="about"
    class="relative isolate overflow-hidden border-b border-bp-line pt-14 pb-16 sm:pt-20 sm:pb-24 print:border-0 print:pt-4 print:pb-0"
  >
    <div
      class="bp-grid bp-grid-fade absolute inset-0 -z-10 print:hidden"
      aria-hidden="true"
    ></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid gap-12 lg:gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] items-center">
      <div class="hero-text">
        <span class="hero-label inline-flex items-center gap-2.5 font-mono text-xs font-medium tracking-[0.18em] uppercase text-bp-accent mb-6">
          <span
            aria-hidden="true"
            class="inline-block w-2 h-2 bg-bp-signal print:hidden"
          ></span>
          {translations.heroLabel}
        </span>
        <h1 class="font-sans text-[2.6rem] sm:text-6xl lg:text-[4.25rem] font-bold leading-[1.02] tracking-[-0.035em] text-bp-ink mb-4">
          {siteTitle}
        </h1>
        <h2 class="font-sans text-lg sm:text-xl font-medium text-bp-accent mb-6">
          {translations.heroSubtitle}
        </h2>
        {heroIntroContent && (
          <div class="hero-intro text-bp-muted mb-8 max-w-[36rem]">
            <RichText content={heroIntroContent} />
          </div>
        )}
        <div class="flex flex-wrap items-center gap-x-6 gap-y-5">
          <a href="#experience" class="btn-outline print:hidden">
            {translations.seeExperienceBtn}
            <svg
              aria-hidden="true"
              class="w-3.5 h-3.5"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M8 2v12M3 9l5 5 5-5" />
            </svg>
          </a>
          {socials && socials.length > 0 && <Socials socials={socials} />}
        </div>
      </div>

      <figure class="hero-figure relative m-0 w-full max-w-[560px] mx-auto lg:mr-0 print:hidden">
        <SystemDiagram t={translations.diagram} />
      </figure>
    </div>
  </header>
) : (
  <header class="relative isolate overflow-hidden border-b border-bp-line pt-14 pb-10 sm:pt-20 sm:pb-12 print:border-0 print:pt-4 print:pb-0">
    <div
      class="bp-grid bp-grid-fade absolute inset-0 -z-10 print:hidden"
      aria-hidden="true"
    ></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1
        style={
          titleTransition &&
          `view-transition-name: ${titleTransition}; view-transition-class: vt-title`
        }
        class="header-title font-sans text-[2rem] sm:text-5xl font-bold leading-[1.1] tracking-[-0.03em] text-bp-ink"
      >
        {siteTitle}
      </h1>
      {subtitle && (
        <h2 class="header-subtitle mt-4 font-mono text-sm font-normal tracking-wide text-bp-muted print:hidden">
          {subtitle}
        </h2>
      )}
    </div>
  </header>
)}

<style>
  @keyframes slideUp {
    from {
      transform: translateY(12px);
    }
    to {
      transform: translateY(0);
    }
  }

  .header-title {
    animation: slideUp 0.4s ease-out both;
  }

  .header-subtitle {
    animation: slideUp 0.4s ease-out 0.1s both;
  }

  .hero-text {
    animation: slideUp 0.4s ease-out both;
  }

  /* The CMS intro paragraph: body serif, slightly larger than running text */
  .hero-intro :global(.cms-content) {
    font-size: 1.125rem;
    line-height: 1.65;
    color: inherit;
  }

  .hero-intro :global(.cms-content p) {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-title,
    .header-subtitle,
    .hero-text {
      animation: none;
    }
  }
</style>
